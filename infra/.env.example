# ═══════════════════════════════════════════════════════════════════════════
# Alloyal Pulse — variáveis de ambiente
#
# Este arquivo É versionado. O `.env` real NÃO é (ver .gitignore e
# infra/secrets/README.md).
#
# Fonte de verdade: infra/secrets/pulse.env.sops.yaml, cifrado com SOPS + age.
# O `.env` é PRODUZIDO por `make secrets-decrypt` e tem permissão 600.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Banco ────────────────────────────────────────────────────────────────
POSTGRES_PULSE_PASSWORD=trocar

# Um usuário por superfície. É o que faz o isolamento sobreviver a bug de
# aplicação: a superfície interna não tem grant em public_v, e o portal não tem
# grant em nada além dele (migrations 0001 e 0005).
# As URLs de conexão de API, portal e worker NÃO ficam aqui: o docker-compose as
# monta a partir de PULSE_API_PASSWORD, PULSE_PORTAL_PASSWORD e PULSE_WORKER_PASSWORD.
# Escrevê-las à mão punha a mesma senha em duas linhas, e na primeira rotação uma das
# duas ficava velha — com sintoma de "autenticação falhou" que ninguém liga ao .env.
#
# Só a ADMIN fica escrita, porque quem a usa são as migrations e o seed, rodados fora
# do compose (Makefile), onde não há quem monte a string.
DATABASE_URL_ADMIN=postgres://postgres:trocar@127.0.0.1:5444/pulse

PULSE_API_PASSWORD=trocar
PULSE_PORTAL_PASSWORD=trocar
PULSE_WORKER_PASSWORD=trocar

# ─── Fila ─────────────────────────────────────────────────────────────────
REDIS_PULSE_PASSWORD=trocar
REDIS_URL=redis://:trocar@redis-pulse:6379/0

# ─── Réplica de leitura da Alloyal (F1) ───────────────────────────────────
# Credencial SOMENTE LEITURA, distinta da credencial de escrita do Pulse.
# Pendente de C-05 (doc 02): a VM alcança a réplica? host, porta, base?
REPLICA_URL=

# ─── Identidade ───────────────────────────────────────────────────────────
# PROVA de que a requisição passou pelo proxy (ADR-016).
#
# Em Server Component do Next não existe acesso ao endereço de rede de quem
# chamou, e x-forwarded-for é cabeçalho — usar cabeçalho para se defender de
# cabeçalho falsificado é circular. Por isso a prova é um SEGREDO que o Nginx
# Proxy Manager injeta e a aplicação confere.
#
#   openssl rand -hex 32
#
# Sem ele a aplicação RECUSA autenticar: configuração incompleta não pode virar
# sistema aberto.
PULSE_PROXY_SECRET=trocar
AUTH_DOMINIO=alloyal.com.br

# Faixa de rede do proxy. Prova alternativa, usada onde o endereço do peer é
# real — não vale para o Next.
PROXY_TRUSTED_CIDRS=172.16.0.0/12

# Identidade de desenvolvimento local. NUNCA funciona com NODE_ENV=production:
# a checagem de ambiente vem primeiro e nenhuma variável a desliga.
PULSE_DEV_EMAIL=
PULSE_DEV_PAPEIS=pulse-admin

# Service account com delegação para ler grupos do Workspace (papéis).
# Escopo mínimo: admin.directory.group.readonly
GOOGLE_SA_JSON=
GOOGLE_ADMIN_SUBJECT=

# ─── Integrações ──────────────────────────────────────────────────────────
HUBSPOT_TOKEN=
HUBSPOT_WEBHOOK_SECRET=
CLEVERTAP_ACCOUNT_ID=
CLEVERTAP_PASSCODE=
CLEVERTAP_REGION=
OMIE_APP_KEY=
OMIE_APP_SECRET=
EVOLUTION_BASE_URL=
EVOLUTION_TOKEN=

# ─── E-mail (magic link e relatório) ──────────────────────────────────────
SMTP_URL=
EMAIL_REMETENTE=ops@alloyal.com.br

# ─── Portal ───────────────────────────────────────────────────────────────
PORTAL_BASE_URL=https://cliente.alloyal.com.br
MAGIC_LINK_TTL_MIN=20

# ─── Tetos de custo (doc 00, 15) ──────────────────────────────────────────
LLM_TETO_MENSAL_BRL=0

# Chave mestra da cifra dos segredos cadastrados pela tela de Configurações.
# 32 bytes em base64. Gere com: openssl rand -base64 32
# NUNCA em texto claro no repositório — só aqui como exemplo vazio e no SOPS.
PULSE_CHAVE_MESTRA=
