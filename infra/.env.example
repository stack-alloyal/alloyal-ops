# ═══════════════════════════════════════════════════════════════════════════
# Alloyal Ops — variáveis de ambiente
#
# Este arquivo É versionado. O `.env` real NÃO é (ver .gitignore e
# infra/secrets/README.md).
#
# Fonte de verdade: infra/secrets/ops.env.sops.yaml, cifrado com SOPS + age.
# O `.env` é PRODUZIDO por `make secrets-decrypt` e tem permissão 600.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Banco ────────────────────────────────────────────────────────────────
POSTGRES_OPS_PASSWORD=trocar

# Um usuário por superfície. É o que faz o isolamento sobreviver a bug de
# aplicação: a superfície interna não tem grant em public_v, e o portal não tem
# grant em nada além dele (migrations 0001 e 0005).
DATABASE_URL_ADMIN=postgres://postgres:trocar@postgres-ops:5432/ops
DATABASE_URL_API=postgres://ops_api:trocar@postgres-ops:5432/ops
DATABASE_URL_PORTAL=postgres://ops_portal:trocar@postgres-ops:5432/ops
DATABASE_URL_WORKER=postgres://ops_worker:trocar@postgres-ops:5432/ops

OPS_API_PASSWORD=trocar
OPS_PORTAL_PASSWORD=trocar
OPS_WORKER_PASSWORD=trocar

# ─── Fila ─────────────────────────────────────────────────────────────────
REDIS_OPS_PASSWORD=trocar
REDIS_URL=redis://:trocar@redis-ops:6379/0

# ─── Réplica de leitura da Alloyal (F1) ───────────────────────────────────
# Credencial SOMENTE LEITURA, distinta da credencial de escrita do Ops.
# Pendente de C-05 (doc 02): a VM alcança a réplica? host, porta, base?
REPLICA_URL=

# ─── Identidade ───────────────────────────────────────────────────────────
# Faixa de onde o oauth2-proxy fala com a aplicação. Fora dela, o cabeçalho de
# identidade é IGNORADO (ADR-016). Não ampliar sem entender a consequência.
PROXY_TRUSTED_CIDRS=172.16.0.0/12
AUTH_DOMINIO=alloyal.com.br

# Service account com delegação para ler grupos do Workspace (papéis).
# Escopo mínimo: admin.directory.group.readonly
GOOGLE_SA_JSON=
GOOGLE_ADMIN_SUBJECT=

# ─── Integrações ──────────────────────────────────────────────────────────
HUBSPOT_TOKEN=
HUBSPOT_WEBHOOK_SECRET=
CLEVERTAP_ACCOUNT_ID=
CLEVERTAP_PASSCODE=
CLEVERTAP_REGION=
OMIE_APP_KEY=
OMIE_APP_SECRET=
EVOLUTION_BASE_URL=
EVOLUTION_TOKEN=

# ─── E-mail (magic link e relatório) ──────────────────────────────────────
SMTP_URL=
EMAIL_REMETENTE=ops@alloyal.com.br

# ─── Portal ───────────────────────────────────────────────────────────────
PORTAL_BASE_URL=https://cliente.alloyal.com.br
MAGIC_LINK_TTL_MIN=20

# ─── Tetos de custo (doc 00, 15) ──────────────────────────────────────────
LLM_TETO_MENSAL_BRL=0
