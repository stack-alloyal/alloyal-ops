# oauth2-proxy de docs.alloyal.com.br. NÃO versionar o arquivo real.
#
# ⚠️ OAUTH2_PROXY_COOKIE_SECRET precisa ter 16, 24 ou 32 BYTES.
#    Use:     openssl rand -hex 16     → 32 caracteres, correto
#    NÃO use: openssl rand -base64 32  → 44 caracteres, erro de AES
#    (armadilha documentada em /opt/stack/CLAUDE.md)
#
# O client OAuth pode ser o mesmo dos outros apps, desde que a URI de redirect
# https://docs.alloyal.com.br/oauth2/callback seja adicionada nele.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
